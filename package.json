{
  "name": "fuyardesque",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev -w packages/server",
    "dev:client": "npm run dev -w packages/client",
    "build": "npm run build -w packages/shared && npm run build -w packages/server && npm run build -w packages/client",
    "start": "node packages/server/dist/server.js",
    "test": "npm run test -w packages/server",
    "test:all": "npm run test -w packages/server && tsx packages/server/tests/multiplayer.test.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
